# Postgres. Compose собирает адрес для контейнеров сам: хост внутри сети — postgres.
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_DB=payment
POSTGRES_PORT=5432

# RabbitMQ. Адрес для контейнеров собирается сам: хост внутри сети — rabbitmq.
RABBITMQ_USER=payment
RABBITMQ_PASSWORD=payment
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Ключ заголовка X-API-Key.
API_KEY=dev-api-key
API_PORT=8000

# Шлюз и доставка. Эти значения попадают в api, consumer и outbox.
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_ATTEMPTS=3
PROCESSING_MIN_SECONDS=2
PROCESSING_MAX_SECONDS=5
PROCESSING_SUCCESS_RATE=0.9
